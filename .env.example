# TMT OFFICIAL - Environment Variables
# Copy this to .env.local and fill in your values

# =============================================================================
# NEXT.JS / PUBLIC (safe to expose in client bundle)
# =============================================================================

# Site URL (used for emails, redirects, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://tmtofficial.com

# Supabase (public anon key - safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# YouTube API
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=UC...your-channel-id...
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# =============================================================================
# SERVER ONLY (never expose in client bundle)
# =============================================================================

# Supabase Service Role (ADMIN ONLY - never in frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin API Secret (for cron jobs, webhooks)
ADMIN_API_SECRET=generate-a-secure-random-string

# Cron Secret (for Vercel Cron / YouTube sync)
CRON_SECRET=generate-another-secure-random-string

# =============================================================================
# EMAIL - Cloudflare Workers
# =============================================================================

# Cloudflare Email Worker URL (your deployed worker)
CLOUDFLARE_EMAIL_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Cloudflare Email API Token (for authenticating to your worker)
CLOUDFLARE_EMAIL_API_TOKEN=your-cloudflare-api-token

# From email address
EMAIL_FROM=noreply@tmtofficial.com
EMAIL_FROM_NAME=TMT OFFICIAL

# =============================================================================
# AUTH
# =============================================================================

# NextAuth Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=https://tmtofficial.com

# =============================================================================
# OPTIONAL: Third-party integrations
# =============================================================================

# Discord webhook for admin notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Sentry DSN (error tracking)
SENTRY_DSN=https://xxx@sentry.io/xxx

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================

# Uncomment for local development
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000